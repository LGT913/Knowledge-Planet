---
import Base from '../../layouts/Base.astro';
import { DOC_TITLES } from '../../data/docs.js';

export function getStaticPaths() {
  return Object.entries(DOC_TITLES).map(([slug, title]) => ({ params: { slug }, props: { title } }));
}

const { title } = Astro.props;
const chapters = Array.from({ length: 22 }, (_, i) => i);
const sections = ['基础资料', '学习路线', '核心知识', '练习记录'];
---

<Base title={`${title} · 知识档案`}>
  <main class="archive">
    <header class="topbar">
      <a class="identity" href="/" aria-label="返回星轨航图"><span class="crest">⌘</span><span><small>知识档案</small><strong>{title}</strong></span></a>
      <a class="back" href="/" aria-label="返回星轨航图">↶</a>
    </header>

    <section class="progress" aria-label="章节进度">
      <div class="progress-heading"><span>学习档案</span><span>探索进程：未开始</span></div>
      <div class="chapter-caption"><span>基础资料</span><span>知识章节</span><span>归档记录</span></div>
      <div class="slices" aria-hidden="true">
        {chapters.map((chapter, i) => <i class:list={{ current: i === 4, gate: i % 5 === 0 }}></i>)}
      </div>
      <div class="progress-line"><strong>0%</strong><span></span><i></i></div>
      <div class="pointer"></div>
    </section>

    <div class="reading-layout">
      <nav class="contents" aria-label="文档目录">
        <p class="contents-label">档案目录 <span>CONTENTS</span></p>
        {sections.map((section, i) => <a class:list={{ selected: i === 0 }} href={`#section-${i}`}><span>{section}</span>{i === 0 && <small>●</small>}</a>)}
      </nav>
      <article class="reading-panel" id="section-0">
        <div class="panel-title"><span>⊙</span><h1>基础资料</h1><em>{title}</em></div>
        <div class="document">
          <p class="eyebrow">{title} / KNOWLEDGE ARCHIVE</p>
          <h2>{title}</h2>
          <div class="rule"></div>
          <p>这里将收录与「{title}」相关的笔记、路线与实践记录。</p>
          <div class="empty-state"><span class="empty-mark">◇</span><strong>档案内容正在整理</strong><small>内容接入后，将在此展示完整章节与学习记录。</small></div>
          <div class="spark spark-one"></div><div class="spark spark-two"></div>
        </div>
      </article>
    </div>
    <p class="uid">UID:147730179</p>
  </main>
</Base>

<style>
.archive{position:relative;min-height:100vh;overflow:hidden;color:#dce4f0;background:radial-gradient(ellipse at 50% 108%,#9aa8d5 0%,#465786 19%,#202b4b 48%,#111a30 100%);font-family:'Microsoft YaHei',sans-serif}.archive:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(102,132,201,.16),transparent 18%,transparent 82%,rgba(36,65,119,.14)),repeating-linear-gradient(0deg,transparent 0 72px,rgba(172,197,239,.025) 73px 74px);pointer-events:none}.topbar{position:relative;z-index:1;height:48px;padding:7px 5.4%;display:flex;justify-content:space-between;align-items:center}.identity{display:flex;gap:9px;align-items:center;color:#f3e8bd;text-decoration:none}.crest{font-size:22px;color:#d6c58f}.identity>span:last-child{display:grid;gap:1px}.identity small{font-size:10px;letter-spacing:1px}.identity strong{font-size:13px;font-weight:500;letter-spacing:.5px}.back{font-size:28px;color:#e6eaf0;text-decoration:none;transform:scaleX(-1)}.progress{position:relative;height:181px;padding:0 5.2%;}.progress-heading{height:23px;display:flex;justify-content:space-between;border-bottom:1px solid rgba(163,186,224,.2);color:#8da9dc;font-size:14px}.progress-heading span:last-child{color:rgba(181,196,222,.46)}.chapter-caption{position:absolute;top:43px;left:8%;right:7%;display:flex;justify-content:space-between;color:rgba(193,204,224,.65);font-size:12px}.slices{position:absolute;left:8%;right:7%;top:75px;height:89px;display:flex;align-items:stretch;gap:7px;perspective:300px;overflow:hidden}.slices i{position:relative;flex:1;min-width:13px;border:1px solid rgba(163,183,218,.29);background:linear-gradient(90deg,rgba(27,40,67,.94),rgba(93,120,169,.19),rgba(20,30,51,.9));transform:skewY(-2deg);box-shadow:inset 3px 0 8px rgba(148,183,242,.08)}.slices i:before{content:'';position:absolute;top:0;bottom:0;left:4px;width:1px;background:rgba(200,218,248,.2)}.slices i.gate{border-left:3px solid rgba(205,218,239,.72);border-right:2px solid rgba(205,218,239,.4)}.slices i.current{flex:1.8;border:2px solid #8ce4ff;background:linear-gradient(90deg,rgba(45,117,183,.72),rgba(105,197,242,.92),rgba(31,94,158,.66));box-shadow:0 0 22px rgba(92,197,255,.72),inset 0 0 20px rgba(130,222,255,.48)}.progress-line{position:absolute;left:0;right:0;bottom:0;height:18px;background:repeating-linear-gradient(130deg,#1b243a 0 5px,#39435c 5px 9px);border-top:1px solid rgba(218,225,242,.55);border-bottom:1px solid rgba(5,10,19,.9)}.progress-line strong{position:absolute;z-index:2;left:5.3%;top:-8px;padding:0 14px;background:#091326;color:#c8f2ff;border:1px solid #92c9e5;font-size:19px;font-weight:400}.progress-line span{position:absolute;left:25%;right:25%;top:8px;border-top:1px solid rgba(169,190,225,.45)}.progress-line i{position:absolute;left:25%;top:14px;border-left:7px solid transparent;border-right:7px solid transparent;border-bottom:8px solid #dbe9ff}.pointer{position:absolute;bottom:-13px;left:calc(8% + 17.5%);z-index:3;border-left:7px solid transparent;border-right:7px solid transparent;border-bottom:8px solid #d7e8ff}.reading-layout{position:relative;z-index:1;display:grid;grid-template-columns:minmax(220px,30%) 1fr;gap:9px;margin:19px 5.2% 52px;min-height:400px}.contents,.reading-panel{border:1px solid rgba(177,196,227,.24);background:rgba(15,25,48,.32);box-shadow:0 0 24px rgba(83,111,162,.08)}.contents{padding:16px 14px}.contents-label{margin:0 0 14px;color:rgba(195,207,230,.48);font-size:10px;letter-spacing:2px}.contents-label span{float:right;font-size:9px;letter-spacing:1px}.contents>a{height:39px;margin:2px 0;padding:0 15px;display:flex;align-items:center;justify-content:space-between;color:#c2cee0;text-decoration:none;font-size:13px;letter-spacing:.4px;border-left:1px solid rgba(184,204,237,.28)}.contents>a.selected{color:#081529;background:linear-gradient(90deg,#66c7fa,#78c7ef);border:0;box-shadow:0 0 14px rgba(83,197,255,.22)}.contents>a small{color:#173c68;font-size:8px}.reading-panel{padding:0 14px 14px;min-width:0}.panel-title{height:40px;display:flex;align-items:center;gap:10px;border-bottom:1px solid rgba(177,196,227,.22)}.panel-title>span{color:#8dcaf2}.panel-title h1{font-size:14px;font-weight:400;color:#c8d2e0;margin:0}.panel-title em{margin-left:auto;color:rgba(180,196,222,.38);font-style:normal;font-size:10px}.document{position:relative;overflow:hidden;margin-top:12px;min-height:298px;padding:22px 20px;border:1px solid rgba(179,199,230,.27);background:linear-gradient(150deg,rgba(179,196,225,.13),rgba(87,110,157,.09));box-shadow:inset 0 0 34px rgba(156,190,238,.08)}.eyebrow{margin:0;color:#a0b4d2;font-size:9px;letter-spacing:2px}.document h2{margin:13px 0 10px;color:#e1e7ee;font-size:18px;font-weight:400}.rule{height:1px;background:linear-gradient(90deg,rgba(173,199,234,.5),transparent)}.document>p:not(.eyebrow){margin:16px 0;color:#b7c2d3;font-size:13px}.empty-state{height:150px;display:grid;align-content:center;justify-items:center;gap:8px;color:rgba(220,230,244,.58)}.empty-mark{font-size:24px;color:#9fcbf0}.empty-state strong{font-size:12px;font-weight:400}.empty-state small{font-size:10px;color:rgba(194,207,230,.48)}.spark{position:absolute;width:3px;height:3px;border-radius:50%;background:#a9c7ff;box-shadow:0 0 8px #8db7ff}.spark-one{top:80px;left:36%}.spark-two{right:15%;bottom:50px}.uid{position:absolute;left:5.2%;bottom:7px;margin:0;color:#e0e3ea;font:10px Georgia,serif;text-shadow:0 1px 3px #1b2948}
@media(max-width:700px){.progress{height:150px;padding:0 20px}.chapter-caption,.slices{left:20px;right:20px}.chapter-caption{top:39px}.slices{top:68px;height:67px;gap:4px}.progress-heading{font-size:12px}.progress-line strong{left:20px}.pointer{left:38%}.reading-layout{grid-template-columns:1fr;margin:15px 14px 46px;gap:10px}.contents{padding:12px}.contents>a{display:inline-flex;width:49%;box-sizing:border-box}.reading-panel{min-height:300px;padding:0 10px 10px}.document{padding:16px 12px}.empty-state small{text-align:center}.uid{left:16px}}
</style>
