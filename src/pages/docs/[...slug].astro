---
import Base from '../../layouts/Base.astro';
import { DOC_TITLES } from '../../data/docs.js';

export function getStaticPaths() {
  return Object.entries(DOC_TITLES).map(([slug, title]) => ({ params: { slug }, props: { title } }));
}

const { title } = Astro.props;
---
<Base title={`${title} · 建设中`}>
  <main class="container">
    <a class="back" href="/">← 返回星轨航图</a>
    <p class="eyebrow">DOCS</p>
    <h1 class="note-title">{title}</h1>
    <p style="color:var(--muted)">文档页面占位，内容待接入。</p>
  </main>
</Base>
