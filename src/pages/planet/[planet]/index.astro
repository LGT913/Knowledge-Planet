---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { planetByKey } from '../../../data/planets';

export async function getStaticPaths() {
  const posts = await getCollection('notes', (n) => !n.data.private);
  const keys = [...new Set(posts.map((n) => n.data.planet))];
  return keys.map((planet) => ({ params: { planet } }));
}

const { planet } = Astro.params;
const info = planetByKey(planet);
const posts = (
  await getCollection('notes', (n) => n.data.planet === planet && !n.data.private)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${info?.name ?? planet} · 知识星球`}>
  <main class="container">
    <a class="back" href="/">← 返回宇宙</a>
    <p class="eyebrow">{info?.en ?? planet}</p>
    <h1 class="note-title">{info?.name ?? planet}</h1>
    <p class="note-meta">
      <span>{info?.desc}</span>
      <span>{posts.length} 篇笔记</span>
    </p>

    <ul class="list">
      {posts.map((p) => (
        <li>
          <a class="list-title" href={`/planet/${planet}/${p.id.split('/').slice(1).join('/')}`}>
            {p.data.title}
          </a>
          <time>{p.data.date.toISOString().slice(0, 10)}</time>
          {p.data.tags.length > 0 && (
            <p class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
          )}
          {p.data.summary && <p class="summary">{p.data.summary}</p>}
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    gap: 14px;
  }
  .list li {
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .list li:hover { transform: translateY(-2px); border-color: #2c4a86; }
  .list-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .list-title:hover { color: var(--accent); }
  .list time { float: right; color: var(--dim); font-size: 12px; margin-top: 2px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; }
  .summary { color: var(--muted); font-size: 13px; margin: 10px 0 0; line-height: 1.6; }
</style>
