---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import UniverseHome from '../components/UniverseHome.vue';
import { stageOf } from '../data/note-stage.js';

const allNotes = await getCollection('notes', (n) => !n.data.private);
const notes = allNotes.map((note) => {
  const planet = note.data.planet;
  const normalizedId = note.id.replace(/\\/g, '/');
  const subPath = normalizedId.split('/').slice(1).join('/');
  return {
    title: note.data.title,
    href: `/planet/${planet}/${subPath}`,
    planet,
    path: normalizedId,
    // 学习路线阶段（离线按正文关键词预分类，见 src/data/note-stages.json）
    stage: stageOf(note),
  };
});
---
<Base title="星轨航图 · 知识星球">
  <UniverseHome client:load notes={notes} />
</Base>
