---
import Base from '../../layouts/Base.astro';
import NoteGrid from '../../components/NoteGrid.astro';
import { GALAXIES } from '../../data/galaxies';
import { getCollection } from 'astro:content';
import { stageOf } from '../../data/note-stage.js';
import { STAGES } from '../../data/stages.js';

export function getStaticPaths() {
  return GALAXIES.map((g) => ({ params: { slug: g.id }, props: { galaxy: g } }));
}

const { galaxy } = Astro.props;

const STAGE_MAP = Object.fromEntries(STAGES.map((s) => [s.id, s]));

const PLANET_LABELS = {
  system: '系统星球',
  algorithm: '算法星球',
  projects: '作品星球',
  'blog-dev': '工程星球',
  growth: '成长星球',
};

const notes = (await getCollection('notes', (n) => !n.data.private))
  .filter((n) => galaxy.planets.includes(n.data.planet))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'));

let cardIndex = 0;
const toCard = (n) => ({
  title: n.data.title,
  href: `/planet/${n.data.planet}/${n.id.split('/').slice(1).join('/')}`,
  date: n.data.date.toISOString().slice(0, 10),
  tags: n.data.tags.filter((t) => !['system', '八股'].includes(t)).slice(0, 2),
  metaLabel: PLANET_LABELS[n.data.planet] ?? n.data.planet,
  tone: ['tone-a', 'tone-b', 'tone-c', 'tone-d'][cardIndex++ % 4],
});

// 分组策略：知识星系按学习阶段分专栏；作品星系按项目分专栏；其余星系不分组
const groupMode =
  galaxy.id === 'knowledge' ? 'stage' : galaxy.id === 'projects' ? 'project' : 'flat';

const isQuillAgent = (n) => {
  const text = `${n.data.title} ${n.data.tags.join(' ')} ${n.data.summary ?? ''}`;
  return /QuillAgent|创作助手|码字|智能创作/i.test(text);
};

const groupMap = new Map();
for (const n of notes) {
  const key =
    groupMode === 'stage'
      ? stageOf(n)
      : groupMode === 'project'
        ? isQuillAgent(n)
          ? 'quillagent'
          : 'blog'
        : null;

  if (key && !groupMap.has(key)) {
    if (groupMode === 'stage') {
      groupMap.set(key, {
        id: key,
        label: STAGE_MAP[key]?.name ?? PLANET_LABELS[n.data.planet] ?? key,
        sub: STAGE_MAP[key]?.sub ?? '',
        notes: [],
      });
    } else {
      groupMap.set(key, {
        id: key,
        label: key === 'quillagent' ? 'QuillAgent' : '博客系统',
        sub: key === 'quillagent' ? '智能创作助手 · 文档与规范' : 'Spring Boot + Vue3 全栈实践',
        notes: [],
      });
    }
  }

  if (key) groupMap.get(key).notes.push(toCard(n));
}

const orderOf = (id) => {
  if (groupMode === 'project') return id === 'blog' ? 0 : 1;
  const i = STAGES.findIndex((s) => s.id === id);
  return i === -1 ? 99 : i;
};

const groups = [...groupMap.values()].sort((a, b) => orderOf(a.id) - orderOf(b.id));
const flatCards = notes.map(toCard);
const total = notes.length;
const layout = groupMode === 'flat' ? 'flat' : 'shelf';
---

<Base title={`${galaxy.title} · 星系详情`}>
  <main class="galaxy">
    <header class="topbar">
      <a class="back" href="/" aria-label="返回星系航图">← 返回星系航图</a>
      <span class="bread">星系航图 / <em>{galaxy.title}</em></span>
    </header>

    <section class="hero">
      <h1>{galaxy.title}</h1>
      <p>{galaxy.sub}</p>
      <div class="counts">
        {layout === 'shelf' && <span><b>{groups.length}</b><small> 个专栏</small></span>}
        <span><b>{total}</b><small> 篇笔记</small></span>
      </div>
    </section>

    {layout === 'shelf' ? (
      <NoteGrid groups={groups} total={total} mode="shelf" />
    ) : (
      <NoteGrid notes={flatCards} total={total} mode="flat" />
    )}

    <p class="uid">UID:147730179</p>
  </main>
</Base>

<style>
  .galaxy {
    position: relative;
    min-height: 100vh;
    padding-bottom: 40px;
    color: #e8eefc;
    background: radial-gradient(ellipse at 50% -10%, #203561 0%, #0b172e 45%, #030711 100%);
    font-family: 'Microsoft YaHei', sans-serif;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 5.4% 0;
  }

  .back { color: #8fa3c8; text-decoration: none; font-size: 12px; letter-spacing: 1px; }
  .back:hover { color: #8ab4ff; }
  .bread { font-size: 12px; color: #5f7297; letter-spacing: 0.5px; }
  .bread em { font-style: normal; color: #e8e2cf; }

  .hero { padding: 38px 5.4% 22px; border-bottom: 1px solid rgba(201, 184, 134, 0.14); }
  .hero h1 { margin: 0 0 10px; font-size: 32px; font-weight: 500; color: #f3e8bd; letter-spacing: 3px; }
  .hero p { margin: 0; color: #a0b4d2; font-size: 13px; letter-spacing: 1px; }
  .counts { display: flex; gap: 30px; margin-top: 18px; }
  .counts span b { color: #8ab4ff; font-size: 22px; font-weight: 500; margin-right: 6px; }
  .counts span small { color: #6f7a90; font-size: 11px; letter-spacing: 1px; }

  .uid {
    position: absolute;
    left: 5.4%;
    bottom: 12px;
    color: #d4d5d4;
    font: 10px 'Consolas', 'Cascadia Code', monospace;
    margin: 0;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 24px; }
  }
</style>
